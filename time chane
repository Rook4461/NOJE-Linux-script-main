#!/usr/bin/env bash

# Change the system date and time. Run with sudo/root privileges.
set -euo pipefail

if [[ $# -ne 1 ]]; then
	echo "Usage: sudo $0 'YYYY-MM-DD HH:MM:SS'" >&2
	exit 1
fi

if ! date -d "$1" >/dev/null 2>&1; then
	echo "Invalid date/time: $1" >&2
	exit 1
fi

if [[ $EUID -ne 0 ]]; then
	echo "Please run this script with sudo or as root." >&2
	exit 1
fi

date -s "$1"
update
update 333